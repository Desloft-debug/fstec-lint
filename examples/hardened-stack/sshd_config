Port 22
PermitRootLogin no
PasswordAuthentication no
PermitEmptyPasswords no
X11Forwarding no
MaxAuthTries 4
# Ключ и одноразовый код (PAM, например pam_oath)
AuthenticationMethods publickey,keyboard-interactive
LogLevel VERBOSE

# Условные блоки тоже проверяются: директива, заданная внутри Match,
# больше не остаётся невидимой для линтера.
Match Address 10.0.0.0/8
    PasswordAuthentication no
    MaxAuthTries 3
